# Development values that work with compose.yaml. Copy to .env.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://kelasverse:kelasverse@localhost:5432/kelasverse?sslmode=disable
FRONTEND_URL=http://localhost:5173
SMTP_ADDR=localhost:1025
SMTP_FROM=Kelasverse <no-reply@kelasverse.local>

# Auth secrets. Generate your own with `make keys`; never reuse these outside dev.
JWT_PRIVATE_KEY=
OTP_HMAC_KEY=

# Google login (optional in dev; set all three or none). The redirect goes
# through the Vite proxy: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Integration tests create and drop throwaway databases on this server.
TEST_DATABASE_URL=postgres://kelasverse:kelasverse@localhost:5432/postgres?sslmode=disable

# Host ports for compose.yaml. Change them (and DATABASE_URL / SMTP_ADDR)
# if 5432, 1025, or 8025 are already in use on your machine.
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Voice (slice 9). Leave all three empty to disable voice. The values below
# match `livekit-server --dev` from compose.yaml (development only).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
